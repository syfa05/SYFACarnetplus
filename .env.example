# Valeurs de DÉVELOPPEMENT uniquement, fictives. Aucun secret réel dans le dépôt.
SYFA_MODE=central
POSTGRES_PASSWORD=dev-only-change-me
KEYCLOAK_ADMIN_PASSWORD=dev-only-change-me
MINIO_ROOT_PASSWORD=dev-only-change-me
OIDC_ISSUER=http://localhost:8081/realms/syfa
OIDC_AUDIENCE=syfa-gateway

# Rapprochement d'identités (L1) — seuils à calibrer pendant le pilote
ID_MATCH_HIGH=0.90
ID_MATCH_LOW=0.75
ID_MATCH_MAX_POSSIBLE=5

# Chiffrement des colonnes sensibles de la base identité (L1) : 32 octets en base64.
# Générer avec : openssl rand -base64 32 — jamais commitée ; en production, fournie par Vault.
IDENTITY_MASTER_KEY=

# Authentification (L2). `make up` génère ces trois secrets de DÉVELOPPEMENT dans .env ; en production : Vault.
AUTH_SECRET_KEY=
# Clé EC P-256 (PKCS#8, PEM) encodée en base64 sur une ligne : jetons d'accès des patients
PATIENT_JWT_PRIVATE_KEY_B64=
# Réglages optionnels (valeurs par défaut du dossier) : AUTH_OTP_TTL_SECONDS=600, AUTH_OTP_MAX_ATTEMPTS=3,
# AUTH_PIN_MAX_ATTEMPTS=5, AUTH_IDLE_SHARED_PC_SECONDS=900, AUTH_IDLE_SMARTPHONE_SECONDS=1800, AUTH_RATE_IP_PER_MINUTE=30

# Restriction réseau des postes partagés (client syfa-web) : liste de CIDR autorisés. Par défaut : boucle locale seulement.
# Doit désigner un réseau DÉDIÉ AUX POSTES des établissements (ni Wi-Fi invité, ni réseau partagé avec des visiteurs).
# AUTH_ALLOWED_NETWORKS=192.0.2.0/24
# Reverse proxys de confiance : adresses EXACTES des proxys (ou plage /24 au plus large) ; jamais « true », un nombre
# ni une plage large. Sans proxy : laisser vide. Si un proxy est présent mais TRUST_PROXY absent, les clients
# « poste partagé » et l'enrôlement d'appareil sont REFUSÉS (défaillance bruyante voulue).
# TRUST_PROXY=10.0.0.7

# Enrôlement d'un appareil professionnel réservé aux réseaux autorisés (défaut : true), plafonds par professionnel
# AUTH_DEVICE_ENROLMENT_NETWORK_ONLY=true
# AUTH_DEVICE_MAX_ACTIVE=5
# AUTH_DEVICE_REGISTRATIONS_PER_WINDOW=5

# Le proxy doit transmettre l'adresse du client dans X-Forwarded-For (nginx : proxy_set_header X-Forwarded-For $remote_addr;).
# Chaque professionnel doit avoir un numéro 2376XXXXXXXX (attribut phone_number) : sans lui, aucun appareil ne peut être enrôlé.

# Image Keycloak épinglée (défaut : voir infra/docker-compose.yml). À modifier seulement après import réel du realm.
# KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.0

# Cartes santé (lot L4). Numéro d'assistance imprimé au verso (« Carte perdue ? … au … ») : à fixer avant toute impression.
CARDS_ASSISTANCE_NUMBER=
