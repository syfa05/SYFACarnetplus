# Valeurs de DÉVELOPPEMENT uniquement, fictives. Aucun secret réel dans le dépôt.
SYFA_MODE=central
POSTGRES_PASSWORD=dev-only-change-me
KEYCLOAK_ADMIN_PASSWORD=dev-only-change-me
MINIO_ROOT_PASSWORD=dev-only-change-me
OIDC_ISSUER=http://localhost:8081/realms/syfa
OIDC_AUDIENCE=syfa-gateway

# Rapprochement d'identités (L1) — seuils à calibrer pendant le pilote
ID_MATCH_HIGH=0.90
ID_MATCH_LOW=0.75
ID_MATCH_MAX_POSSIBLE=5

# Chiffrement des colonnes sensibles de la base identité (L1) : 32 octets en base64.
# Générer avec : openssl rand -base64 32 — jamais commitée ; en production, fournie par Vault.
IDENTITY_MASTER_KEY=
